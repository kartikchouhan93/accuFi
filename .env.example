# Copy to .env and adjust. .env is git-ignored.
POSTGRES_USER=accufi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=accufi
# Host-side URL (used by `bun run db:migrate`, `bun run dev`). Inside Docker, compose overrides the host to `postgres`.
DATABASE_URL=postgresql://accufi:change-me@localhost:5432/accufi
# The public URL of the app; compose passes it to the container as AUTH_URL, which Auth.js builds its redirects from.
APP_URL=http://localhost:3000
# Host port the app container is published on (change both this and APP_URL if 3000 is taken).
APP_PORT=3000
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
# Number of trusted reverse proxies in front of the app. Leave 0 when the app is reached directly: X-Forwarded-For is
# then ignored, because a client can forge it to dodge the login rate limit. Set to 1 behind a single proxy that
# appends the real client address (nginx, Caddy, Traefik), 2 behind two, and so on.
# This also sets the account-lockout threshold: at 0 every client shares one address, so 10 wrong guesses lock an
# account for 15 minutes; with a proxy declared the per-address limit stays 10 and the account-wide cap of 30 applies.
TRUSTED_PROXY_HOPS=0
# The recurring-entries sweep runs inside the server: once at startup, then every hour. "off" disables it.
# RECURRING_SWEEP=off
# Milliseconds between sweeps (a positive integer; anything else keeps the default of 3600000).
# RECURRING_SWEEP_INTERVAL_MS=3600000
