datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// createdAt defaults to the database clock (dbgenerated now()), never the app's, so app/DB clock skew cannot reorder
// history (EC-66). updatedAt is different: `@updatedAt` makes Prisma supply a value itself on create and on update, so
// the column default never applies. The database clock is enforced by a BEFORE INSERT OR UPDATE trigger on each table
// with an updatedAt ("Transaction": migration updated_at_on_insert_and_keyset_index; "PriceSnapshot": migration
// investments; "RecurringRule": migration recurring_rules; "Budget": migration budgets), which overwrites whatever the statement sent.

// Everything money can come from, sit in, or go to is a ledger node of one of these kinds.
enum LedgerKind {
  INCOME_SOURCE
  ASSET
  INVESTMENT
  EXPENSE
  LIABILITY
}

enum AssetSubtype {
  SAVINGS
  CURRENT
  CASH
  WALLET
}

enum LiabilitySubtype {
  CREDIT_CARD
  LOAN
}

// How an investment is valued (spec §7.1): lots of quantity x unit cost; a single lot of quantity 1;
// or net contributions with no lots or prices.
enum ValuationMode {
  QUANTITY
  LUMP
  CONTRIBUTION_ONLY
}

// Which lots a disposal consumes first (spec §7.5): FIFO by default.
enum LotMethod {
  FIFO
  LIFO
  HIGHEST_COST_FIRST
}

// Where a price snapshot came from (spec §7.4). Mirrors PRICE_SOURCES in src/domain/ledger-kind.ts (pinned by
// tests/db/enum-parity.test.ts). Only MANUAL is written in M2; FEED is the seam for a future price feed.
enum PriceSource {
  MANUAL
  FEED
}

// Nodes the system creates itself, never the user. Mirrors SystemNodeRole in src/domain/ledger-kind.ts
// (pinned by tests/db/enum-parity.test.ts).
enum SystemNodeRole {
  OPENING_BALANCE
  OPENING_BALANCE_CONTRA
  REALISED_GAIN
  REALISED_LOSS
}

// How often a recurring rule fires (design §4). Mirrors RECURRENCE_FREQUENCIES in src/domain/recurrence.ts (pinned by
// tests/db/enum-parity.test.ts).
enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

// PENDING sits in the inbox; POSTED became a transaction; DISMISSED was skipped (and can be put back).
enum OccurrenceStatus {
  PENDING
  POSTED
  DISMISSED
}

// Only MANUAL_SPLIT is reachable in M1; the rest are declared now because adding an enum value later is a migration.
enum GroupKind {
  MANUAL_SPLIT
  DISPOSAL
  EMI
}

model User {
  id                      String   @id @default(cuid())
  email                   String   @unique
  passwordHash            String
  timezone                String   @default("Asia/Kolkata")
  financialYearStartMonth Int      @default(4)
  stalePriceDays          Int      @default(30)
  createdAt               DateTime @default(dbgenerated("now()")) @db.Timestamptz(3)

  nodes                LedgerNode[]
  transactionGroups    TransactionGroup[]
  transactions         Transaction[]
  lots                 InvestmentLot[]
  lotConsumptions      LotConsumption[]
  priceSnapshots       PriceSnapshot[]
  recurringRules       RecurringRule[]
  recurringOccurrences RecurringOccurrence[]
  budgets              Budget[]
  importProfiles       ImportProfile[]
  importBatches        ImportBatch[]
  importRows           ImportRow[]
  counterpartRules     CounterpartRule[]
}

// One table for every node of the ledger; `kind` says which. There is deliberately no balance column
// (not even an opening balance): a balance is always the sum of the node's transactions.
model LedgerNode {
  id               String            @id @default(cuid())
  userId           String
  kind             LedgerKind
  name             String
  parentId         String?
  institution      String?
  lastFour         String?
  assetSubtype     AssetSubtype?
  liabilitySubtype LiabilitySubtype?
  creditLimitPaise BigInt?
  statementDay     Int?
  dueDay           Int?
  valuationMode    ValuationMode?
  unitLabel        String?
  lotMethod        LotMethod?
  stalePriceDays   Int? // per-node override of User.stalePriceDays
  blockNegative    Boolean           @default(false)
  systemRole       SystemNodeRole?
  archivedAt       DateTime?         @db.Timestamptz(3)
  createdAt        DateTime          @default(dbgenerated("now()")) @db.Timestamptz(3)

  user             User              @relation(fields: [userId], references: [id])
  parent           LedgerNode?       @relation("NodeTree", fields: [parentId], references: [id])
  children         LedgerNode[]      @relation("NodeTree")
  outgoing         Transaction[]     @relation("TransactionFrom")
  incoming         Transaction[]     @relation("TransactionTo")
  lots             InvestmentLot[]
  priceSnapshots   PriceSnapshot[]
  recurringFrom    RecurringRule[]   @relation("RecurringFrom")
  recurringTo      RecurringRule[]   @relation("RecurringTo")
  budgets          Budget[]
  importBatches    ImportBatch[]     @relation("ImportAccount")
  importRows       ImportRow[]       @relation("ImportCounterpart")
  importProfiles   ImportProfile[]
  counterpartRules CounterpartRule[]

  // NULLs are distinct in Postgres, so any number of ordinary nodes (systemRole null) coexist; at most one system node per role.
  @@unique([userId, systemRole])
  @@index([userId, kind])
}

// Ties the transactions of one logical event together (a split bill, a disposal, an EMI schedule).
model TransactionGroup {
  id        String    @id @default(cuid())
  userId    String
  kind      GroupKind
  createdAt DateTime  @default(dbgenerated("now()")) @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

// One movement of money from one node to another. An opening balance is just a transaction from the
// system OPENING_BALANCE node.
model Transaction {
  id             String    @id @default(cuid())
  userId         String
  fromNodeId     String
  toNodeId       String
  amountPaise    BigInt
  occurredAt     DateTime  @db.Date // a calendar day, not an instant
  note           String?
  tags           String[]
  groupId        String?
  version        Int       @default(0)
  idempotencyKey String?
  importBatchId  String? // the import batch that created it; null for a transaction made by hand
  importRowId    String?   @unique // the import row it came from
  deletedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(dbgenerated("now()")) @db.Timestamptz(3)
  updatedAt      DateTime  @default(dbgenerated("now()")) @updatedAt @db.Timestamptz(3)

  user         User                 @relation(fields: [userId], references: [id])
  fromNode     LedgerNode           @relation("TransactionFrom", fields: [fromNodeId], references: [id])
  toNode       LedgerNode           @relation("TransactionTo", fields: [toNodeId], references: [id])
  group        TransactionGroup?    @relation(fields: [groupId], references: [id])
  lot          InvestmentLot? // the lot this transaction acquired, if it bought into a lot-mode investment
  consumptions LotConsumption[] // the lots this disposal cost-basis leg consumed
  occurrence   RecurringOccurrence? // the occurrence that became this transaction; there is deliberately no ruleId here
  importBatch  ImportBatch?         @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  importRow    ImportRow?           @relation("TransactionImportRow", fields: [importRowId], references: [id], onDelete: Restrict)
  importedAs   ImportRow?           @relation("ImportRowTransaction") // the row that points at this transaction (the other half of the circle)

  // NULLs are distinct, so any number of transactions without an idempotency key coexist.
  @@unique([userId, idempotencyKey])
  @@index([userId, toNodeId, occurredAt])
  @@index([userId, fromNodeId, occurredAt])
  @@index([userId, occurredAt, id]) // the listing order: (occurredAt, id). The keyset cursor is filtered, not bounded, by it
  @@index([userId, importBatchId]) // what a batch created: its page, its filtered list, its reversal
}

// Fixed-window attempt counters for the auth endpoints (spec §9.5), held in Postgres so they survive a restart
// and need no new infrastructure. `key` is a SHA-256 of scope + IP + email, never the values themselves.
// `windowStart` is always supplied by consumeAttempt from the database clock (no column default), and the window is
// evaluated by the database too. The index serves the sweep that deletes expired windows.
model RateLimitCounter {
  key         String   @id
  windowStart DateTime @db.Timestamptz(3)
  count       Int

  @@index([windowStart])
}

// One lot per acquiring transaction in a QUANTITY or LUMP investment (spec §7.2). There is deliberately no
// remaining-quantity column (§9.4: nothing cached): remaining = quantity - the sum of the lot's live consumptions, where
// a lot is live while its acquiring transaction is not deleted and a consumption while its disposal is not deleted.
// quantity, costBasisPaise > 0 are CHECK constraints (migration investments); Prisma cannot express them.
model InvestmentLot {
  id             String   @id @default(cuid())
  userId         String
  nodeId         String
  transactionId  String   @unique // one lot per acquiring transaction
  quantity       Decimal  @db.Decimal(18, 6)
  costBasisPaise BigInt // authoritative; equals the acquiring transaction's amount
  acquiredAt     DateTime @db.Date // a calendar day, copied from the transaction
  createdAt      DateTime @default(dbgenerated("now()")) @db.Timestamptz(3)

  user         User             @relation(fields: [userId], references: [id])
  node         LedgerNode       @relation(fields: [nodeId], references: [id])
  transaction  Transaction      @relation(fields: [transactionId], references: [id])
  consumptions LotConsumption[]

  @@index([userId, nodeId, acquiredAt])
}

// How much of one lot one disposal consumed (spec §7.5). transactionId is the disposal's cost-basis leg, the
// INVESTMENT -> ASSET transaction; without this table editing or deleting a disposal could not be unwound.
model LotConsumption {
  id             String   @id @default(cuid())
  userId         String
  lotId          String
  transactionId  String
  quantity       Decimal  @db.Decimal(18, 6)
  costBasisPaise BigInt
  createdAt      DateTime @default(dbgenerated("now()")) @db.Timestamptz(3)

  user        User          @relation(fields: [userId], references: [id])
  lot         InvestmentLot @relation(fields: [lotId], references: [id])
  transaction Transaction   @relation(fields: [transactionId], references: [id])

  @@unique([lotId, transactionId])
  @@index([userId, transactionId])
}

// A manually entered (or, later, fed) price for one unit of an investment on a day (spec §7.3). Re-entering a day
// overwrites it. updatedAt is stamped by the database clock through the same trigger as Transaction (EC-66).
model PriceSnapshot {
  id                String      @id @default(cuid())
  userId            String
  nodeId            String
  asOf              DateTime    @db.Date // a calendar day
  pricePerUnitPaise BigInt
  source            PriceSource @default(MANUAL)
  createdAt         DateTime    @default(dbgenerated("now()")) @db.Timestamptz(3)
  updatedAt         DateTime    @default(dbgenerated("now()")) @updatedAt @db.Timestamptz(3)

  user User       @relation(fields: [userId], references: [id])
  node LedgerNode @relation(fields: [nodeId], references: [id])

  @@unique([nodeId, asOf])
  @@index([userId, nodeId, asOf])
}

// A template for a transaction that repeats (design §5): the entry to book, and the schedule it follows. It holds no
// postings itself; each due date becomes a RecurringOccurrence, and only a confirmed (or auto-posted) occurrence becomes a
// transaction. nextDueOn is the next date to generate and is null once the schedule has ended, so the due scan is one
// indexed range read. dayOfMonth 31 means "the last day" by the clamp in src/domain/recurrence.ts. Deletion is soft.
// interval >= 1, dayOfMonth null or 1-31, dayOfWeek null or 1-7, amountPaise > 0 and occurrenceLimit null or >= 1 are
// CHECK constraints (migration recurring_rules); Prisma cannot express them.
model RecurringRule {
  id              String              @id @default(cuid())
  userId          String
  name            String // 1-60 chars, validated in the service
  fromNodeId      String
  toNodeId        String
  amountPaise     BigInt
  note            String?
  tags            String[]
  frequency       RecurrenceFrequency
  interval        Int                 @default(1)
  dayOfMonth      Int?
  dayOfWeek       Int?
  startDate       DateTime            @db.Date // a calendar day
  endDate         DateTime?           @db.Date
  occurrenceLimit Int?
  autoPost        Boolean             @default(false)
  nextDueOn       DateTime?           @db.Date
  pausedAt        DateTime?           @db.Timestamptz(3)
  version         Int                 @default(0)
  idempotencyKey  String?
  deletedAt       DateTime?           @db.Timestamptz(3)
  createdAt       DateTime            @default(dbgenerated("now()")) @db.Timestamptz(3)
  updatedAt       DateTime            @default(dbgenerated("now()")) @updatedAt @db.Timestamptz(3)

  user        User                  @relation(fields: [userId], references: [id])
  fromNode    LedgerNode            @relation("RecurringFrom", fields: [fromNodeId], references: [id])
  toNode      LedgerNode            @relation("RecurringTo", fields: [toNodeId], references: [id])
  occurrences RecurringOccurrence[]

  // NULLs are distinct, so any number of rules without an idempotency key coexist.
  @@unique([userId, idempotencyKey])
  @@index([userId, nextDueOn]) // the due scan
}

// One due date of one rule. A pending occurrence lives here, not in Transaction, so it cannot reach a balance, net worth
// or report query by construction (EC-47). @@unique([ruleId, dueOn]) is the guard against a duplicate when the hourly
// sweep and a login race; transactionId (unique) is the transaction the occurrence became, and postFailure says why an
// auto-post did not happen.
model RecurringOccurrence {
  id            String           @id @default(cuid())
  userId        String
  ruleId        String
  dueOn         DateTime         @db.Date // a calendar day
  status        OccurrenceStatus @default(PENDING)
  transactionId String?          @unique
  postFailure   String?
  resolvedAt    DateTime?        @db.Timestamptz(3)
  createdAt     DateTime         @default(dbgenerated("now()")) @db.Timestamptz(3)

  user        User          @relation(fields: [userId], references: [id])
  rule        RecurringRule @relation(fields: [ruleId], references: [id])
  transaction Transaction?  @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([ruleId, dueOn])
  @@index([userId, status, dueOn]) // the inbox
}

// A monthly spending cap on one expense ledger (M5 design §5). One row is a span of calendar months, startMonth to
// endMonth inclusive (null: open-ended), with one amount; changing the amount from a later month splits the span in
// two. Nothing else is stored: what was spent, the status and any rollover carry are computed from the transactions.
// Months are DATE columns holding the first day of the month. amountPaise > 0, startMonth the first of a month, and
// endMonth null or the first of a month and >= startMonth are CHECK constraints (migration budgets); Prisma cannot
// express them. Overlapping spans for one ledger are refused by the service under a lock on the ledger row, not here
// (an exclusion constraint would need btree_gist), and so is ownership of the ledger. Deletion is hard.
model Budget {
  id          String    @id @default(cuid())
  userId      String
  nodeId      String
  amountPaise BigInt
  startMonth  DateTime  @db.Date // the first day of a month
  endMonth    DateTime? @db.Date // the first day of the last month it applies to
  rollover    Boolean   @default(false)
  createdAt   DateTime  @default(dbgenerated("now()")) @db.Timestamptz(3)
  updatedAt   DateTime  @default(dbgenerated("now()")) @updatedAt @db.Timestamptz(3)

  user User       @relation(fields: [userId], references: [id])
  node LedgerNode @relation(fields: [nodeId], references: [id])

  @@index([userId, nodeId, startMonth])
}

enum ImportBatchStatus {
  UPLOADED
  STAGED
  COMMITTED
  REVERSED
  DISCARDED
}

enum ImportRowStatus {
  PENDING
  READY
  SKIPPED
  ERRORED
  COMMITTED
}

// The direction of a statement row relative to the batch's account: OUT leaves it, IN enters it. Its members equal
// IMPORT_DIRECTIONS in src/domain/import-map.ts (tests/db/enum-parity.test.ts compares them).
enum ImportDirection {
  OUT
  IN
}

// A saved column mapping (M6 design §5), reused for the next statement from the same bank. `settings` is the mapping
// as JSON; its shape belongs to the service. nodeId is the account it was made for, optional.
model ImportProfile {
  id        String   @id @default(cuid())
  userId    String
  name      String
  nodeId    String?
  settings  Json
  createdAt DateTime @default(dbgenerated("now()")) @db.Timestamptz(3)
  updatedAt DateTime @default(dbgenerated("now()")) @updatedAt @db.Timestamptz(3)

  user    User          @relation(fields: [userId], references: [id])
  node    LedgerNode?   @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  batches ImportBatch[]

  @@unique([userId, name])
}

// One uploaded statement, for one account. fileBytes holds the raw file until the batch ends and is then dropped (no
// default: null once there is nothing to re-map). fileHash is the SHA-256 in lowercase hex and is how a re-upload of the
// same bytes is noticed. fileHash being 64 lowercase hex characters, fileSize in 1..5242880 and rowCount >= 0 are CHECK
// constraints (migration csv_import); Prisma cannot express them. Ownership of the account is the service's job.
model ImportBatch {
  id          String            @id @default(cuid())
  userId      String
  nodeId      String // the account the statement is for
  fileName    String
  fileSize    Int
  fileHash    String
  fileBytes   Bytes?
  status      ImportBatchStatus @default(UPLOADED)
  mapping     Json?
  profileId   String?
  rowCount    Int
  committedAt DateTime?         @db.Timestamptz(3)
  reversedAt  DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(dbgenerated("now()")) @db.Timestamptz(3)

  user         User           @relation(fields: [userId], references: [id])
  node         LedgerNode     @relation("ImportAccount", fields: [nodeId], references: [id])
  profile      ImportProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  rows         ImportRow[]
  transactions Transaction[]

  @@index([userId, fileHash])
  @@index([userId, createdAt])
}

// One line of a statement as staged. raw is the cells as read; the parsed fields are null until parsing succeeds.
// occurrenceId (a pending recurring occurrence it was linked to) and duplicateOfTransactionId (the probable duplicate
// found) are plain pointers with deliberately NO foreign key: a pending occurrence is hard-deleted when its rule is
// deleted, so a RESTRICT key would make deleting a rule fail, and the duplicate link is re-validated where it is used.
// transactionId (unique) is what the row became; Transaction.importRowId is the same link from the other side, so the
// two foreign keys are circular and cleanup nulls transactionId first. line >= 1, amountPaise null or > 0, and the
// status rules (READY needs a counterpart, COMMITTED needs a transaction and a counterpart, ERRORED needs a reason) are
// CHECK constraints (migration csv_import).
model ImportRow {
  id                       String           @id @default(cuid())
  userId                   String
  batchId                  String
  line                     Int // the line in the file
  raw                      String[]
  status                   ImportRowStatus  @default(PENDING)
  errorReason              String?
  occurredOn               DateTime?        @db.Date // a calendar day
  amountPaise              BigInt?
  direction                ImportDirection?
  description              String?
  descriptionKey           String?
  counterpartNodeId        String?
  duplicateOfTransactionId String?
  occurrenceId             String?
  transactionId            String?          @unique
  createdAt                DateTime         @default(dbgenerated("now()")) @db.Timestamptz(3)

  user        User         @relation(fields: [userId], references: [id])
  batch       ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Restrict)
  counterpart LedgerNode?  @relation("ImportCounterpart", fields: [counterpartNodeId], references: [id], onDelete: Restrict)
  transaction Transaction? @relation("ImportRowTransaction", fields: [transactionId], references: [id], onDelete: Restrict)
  created     Transaction? @relation("TransactionImportRow") // the transaction that points at this row

  @@unique([batchId, line])
  @@index([userId, batchId, status])
}

// A suggestion learned from commits: for this user, a row of this direction whose description key is this one went to
// this ledger. The latest choice wins (hits counts how often it was chosen). Nothing the user made by hand.
model CounterpartRule {
  id             String          @id @default(cuid())
  userId         String
  direction      ImportDirection
  descriptionKey String
  nodeId         String
  hits           Int             @default(1)
  createdAt      DateTime        @default(dbgenerated("now()")) @db.Timestamptz(3)
  updatedAt      DateTime        @default(dbgenerated("now()")) @updatedAt @db.Timestamptz(3)

  user User       @relation(fields: [userId], references: [id])
  node LedgerNode @relation(fields: [nodeId], references: [id])

  @@unique([userId, direction, descriptionKey])
}
